# Environment variables for End-to-End (E2E) tests
# This file contains MOCK credentials for testing purposes
# Replace with REAL credentials when you're ready to run actual E2E tests

# ============================================================================
# MOCK CREDENTIALS (for demonstration/testing setup only)
# ============================================================================

# Google OAuth Access Token (MOCK - replace with real token)
# To get a real token, follow steps in tests/README_TESTING.md
# Real tokens look like: ya29.a0AfB_byC1234567890abcdefghijklmnopqrstuvwxyz...
GOOGLE_SHEETS_TEST_ACCESS_TOKEN=mock_access_token_replace_with_real

# Test Spreadsheet ID (MOCK - replace with real spreadsheet ID)
# To get a real ID:
# 1. Create a Google Sheet
# 2. Copy ID from URL: https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/edit
# Real IDs look like: 1A2B3C4D5E6F7G8H9I0J1K2L3M4N5O6P7Q8R9S0
GOOGLE_SHEETS_TEST_SPREADSHEET_ID=mock_spreadsheet_id_replace_with_real

# Test Sheet Name (defaults to "Sheet1" if not provided)
# This should be the name of a sheet/tab in your test spreadsheet
GOOGLE_SHEETS_TEST_SHEET_NAME=Sheet1

# Test Sheet ID (defaults to 0 for the first sheet)
# Usually 0 for the first sheet, 1 for second, etc.
GOOGLE_SHEETS_TEST_SHEET_ID=0

# Skip E2E tests flag (set to "true" to skip E2E tests)
# Set to "false" when you have real credentials and want to run E2E tests
SKIP_E2E_TESTS=true

# ============================================================================
# HOW TO GET REAL CREDENTIALS
# ============================================================================
#
# Step 1: Get Google OAuth Access Token
# ---------------------------------------
# Option A (Easiest): Using OAuth Playground
#   1. Go to: https://developers.google.com/oauthplayground/
#   2. Click gear icon (⚙️) → Check "Use your own OAuth credentials"
#   3. Enter your OAuth Client ID and Secret from Google Cloud Console
#   4. In Step 1, select "Google Sheets API v4"
#   5. Select scope: https://www.googleapis.com/auth/spreadsheets
#   6. Click "Authorize APIs" and complete the flow
#   7. Click "Exchange authorization code for tokens"
#   8. Copy the "Access token"
#
# Option B: Using Google Cloud Console
#   1. Go to: https://console.cloud.google.com/
#   2. Create a project or select existing one
#   3. Enable Google Sheets API
#   4. Create OAuth 2.0 credentials
#   5. Generate access token using your preferred method
#
# Note: Access tokens expire after ~1 hour. For long-term testing,
#       consider using refresh tokens or service accounts.
#
# Step 2: Create Test Spreadsheet
# ---------------------------------
#   1. Go to: https://sheets.google.com/
#   2. Create a new spreadsheet
#   3. Name it "Connector E2E Test" (or any name)
#   4. Copy the Spreadsheet ID from the URL:
#      https://docs.google.com/spreadsheets/d/SPREADSHEET_ID_HERE/edit
#   5. Paste the ID above as GOOGLE_SHEETS_TEST_SPREADSHEET_ID
#
# Step 3: Update This File
# -------------------------
#   1. Replace GOOGLE_SHEETS_TEST_ACCESS_TOKEN with your real token
#   2. Replace GOOGLE_SHEETS_TEST_SPREADSHEET_ID with your real ID
#   3. Set SKIP_E2E_TESTS=false
#   4. Update GOOGLE_SHEETS_TEST_SHEET_NAME if needed (default: Sheet1)
#
# Step 4: Run E2E Tests
# ---------------------
#   pytest tests/test_e2e_google_sheets.py -v
#
# ============================================================================

